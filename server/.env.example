# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobpulse?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_32_character_secret_key

# Client CORS & Email Link Origin
CLIENT_URL=http://localhost:5173

# Cron Schedule (Default: Daily at 09:00 UTC)
CRON_SCHEDULE=0 9 * * *

# Resend Email Configuration (Optional — email reminders work when provided, server operates safely without)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=JobPulse <onboarding@resend.dev>

# Google Gemini AI (Required for AI Resume Match & JD Analysis)
GEMINI_API_KEY=your_gemini_api_key_here
